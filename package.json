{
  "name": "budget-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
"electron:dev": "concurrently -k \"npm.cmd run dev\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron.cmd .\"",    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.mansheim.budgetprocessor",
    "productName": "Mansheim Budget Processor",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.1",
    "wait-on": "^8.0.1"
  }
}
